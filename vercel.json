{
  "version": 2,
  "framework": "nextjs",
  "functions": {
    "pages/api/stream.js": {
      "maxDuration": 30
    },
    "pages/api/search.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
